# Environment variables for the production compose stack.
# Copy this file to `.env` and fill in real values. The real `.env` is
# gitignored; gitleaks (pre-commit + CI) blocks accidental commits of
# secret material into tracked files.

# Cloudflare Tunnel connector token. Required only when running the
# `cloudflared` service in `docker-compose.yml`. Provision at:
#   Cloudflare dashboard → Zero Trust → Networks → Tunnels →
#   Create tunnel → copy the connector token.
#
# For local dev, the local-dev override (docker-compose.local.yml) sets
# this to a placeholder so you don't need a real Cloudflare account.
TUNNEL_TOKEN=
